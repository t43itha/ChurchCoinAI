# Frontend environment variables (.env.local / Vercel project settings)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional deployed commit/version shown in support diagnostics.
# VITE_APP_RELEASE=git-sha-or-release-name
# Optional landing-page Book a Demo destination. Without it, the CTA opens
# an email request to hello@churchcoin.ai.
# VITE_DEMO_BOOKING_URL=https://cal.example.com/churchcoin-demo

# Optional frontend error monitoring. The DSN is intentionally public.
VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
VITE_SENTRY_ENVIRONMENT=development

# Backend environment variables (Convex Dashboard or `npx convex env set`)
# APP_BASE_URL=https://app.example.org
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# OPENROUTER_API_KEY=your-project-scoped-openrouter-key
# CATEGORIZATION_AI_PROVIDER=openrouter # openrouter, gemini, or openai
# OPENROUTER_CATEGORIZATION_MODEL=openai/gpt-5.6-luna
# OPENAI_API_KEY=your-project-scoped-openai-key
# OPENAI_CATEGORIZATION_MODEL=gpt-5.6-luna
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# In-app support tickets. Point this at a separate PRIVATE repository.
# Preferred authentication: a GitHub App installed only on that repository,
# with Metadata: read and Issues: read/write permissions.
# GITHUB_SUPPORT_OWNER=your-github-owner
# GITHUB_SUPPORT_REPO=ChurchCoinAI-Support
# GITHUB_APP_ID=123456
# GITHUB_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Temporary alternative to the three GitHub App values above: a fine-grained
# token limited to the private support repository with Issues read/write.
# GITHUB_SUPPORT_TOKEN=github_pat_...

# Invitation email. RESEND_FROM_EMAIL must use a verified custom domain;
# ChurchCoin deliberately rejects the resend.dev sandbox sender for invites.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=ChurchCoin <onboarding@example.org>

# Yapily (UK Open Banking provider)
# YAPILY_APPLICATION_ID=your-application-id
# YAPILY_APPLICATION_SECRET=your-application-secret
# YAPILY_CALLBACK_URL=https://your-deployment.convex.site/yapily/callback
# YAPILY_API_BASE_URL=https://api.yapily.com

# Preserved Plaid compatibility (only required for existing Plaid connections)
# PLAID_CLIENT_ID=your-client-id
# PLAID_SECRET=your-secret-key
# PLAID_ENV=sandbox
# PLAID_WEBHOOK_URL=https://your-deployment.convex.site/plaid/webhook

# Stripe Billing
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWING=price_...
# STRIPE_PRICE_THRIVING=price_...
# STRIPE_PRODUCT_STARTER=prod_...
# STRIPE_PRODUCT_GROWING=prod_...
# STRIPE_PRODUCT_THRIVING=prod_...
