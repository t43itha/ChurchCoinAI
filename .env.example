# Frontend environment variables (create .env.local with these values)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend environment variables (set in Convex Dashboard)
# GEMINI_API_KEY=your-gemini-api-key
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# GoCardless Bank Account Data (UK Open Banking) - set in Convex Dashboard
# Sandbox institution: SANDBOXFINANCE_SFIN0000
# Get credentials from https://bankaccountdata.gocardless.com
# GOCARDLESS_SECRET_ID=your-secret-id
# GOCARDLESS_SECRET_KEY=your-secret-key
# GOCARDLESS_REDIRECT_URL=https://your-deployment.convex.site/gocardless/callback
# GOCARDLESS_INSTITUTION_ID=SANDBOXFINANCE_SFIN0000
# GOCARDLESS_COUNTRY=GB
# GOCARDLESS_INSTITUTION_NAME=GoCardless Sandbox
# Optional:
# GOCARDLESS_API_BASE_URL=https://bankaccountdata.gocardless.com/api/v2

# Plaid preserved compatibility webhook - set in Convex Dashboard only if needed
# Get credentials from https://dashboard.plaid.com/developers/keys
# PLAID_CLIENT_ID=your-client-id
# PLAID_SECRET=your-secret-key
# PLAID_ENV=sandbox (use 'development' or 'production' for live banks)
# PLAID_WEBHOOK_URL=https://your-deployment.convex.site/plaid/webhook

# Stripe Billing - set in Convex Dashboard
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWING=price_...
# STRIPE_PRICE_THRIVING=price_...
